# Load the dataframe
df = dfs[0]

# 1. Calculate the mean pass rate by context type to see the direct impact of test availability
context_impact = df.groupby('contextType')['testCasePassRate'].mean().sort_values(ascending=False).reset_index()

# 2. Analyze the relationship between the quantity of relevant test cases provided and performance
# We'll check if more tests (relevantTestCaseCount) consistently lead to higher pass rates.
count_vs_performance = df.groupby('relevantTestCaseCount')['testCasePassRate'].mean().reset_index()

# 3. Model sensitivity: Check if different models benefit differently from context
