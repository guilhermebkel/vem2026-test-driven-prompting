            import pandas as pd
import matplotlib.pyplot as plt

# Load the data from the provided list of dataframes
df = dfs[0].copy()

# Pre-processing: Ensure 'isTestSuiteSuccessful' is numeric (0 or 1) to calculate the mean success rate
df['isTestSuiteSuccessful'] = df['isTestSuiteSuccessful'].astype(float)

# List of repositories we want to plot
repositories = ['date-fns', 'directus']

# Initialize the figure with two subplots side by side
fig, axes = plt.subplots(1, 2, figsize=(18, 8), sharey=True)

for i, repo in enumerate(repositories):
    # Filter the dataframe for the specific repository
    repo_df = df[df['repositoryName'] == repo]
    
    if not repo_df.empty:
        # Create a pivot table to aggregate success rate
        # X-axis: experimentTitle (Context)
        # Grouping (Legend): methodName (as requested "model (methodName)")
        # Values: Mean of isTestSuiteSuccessful
        pivot_df = repo_df.pivot_table(
            index='experimentTitle',
            columns='methodName',
            values='isTestSuiteSuccessful',
            aggfunc='mean'
        )
        
        # Plot the data as a bar chart on the current subplot axis
        pivot_df.plot(kind='bar', ax=axes[i])
        
        # Configure chart aesthetics
        axes[i].set_title(f'Success Rate by Context: {repo}', fontsize=14)
        axes[i].set_xlabel('Context (experimentTitle)', fontsize=12)
        axes[i].set_ylabel('Success Rate', fontsize=12)
        axes[i].set_ylim(0, 1.1)
        
        # Rotate x-axis labels for readability
        axes[i].tick_params(axis='x', rotation=45)
        
        # Adjust legend position to not overlap bars
        axes[i].legend(title='Method Name', loc='best', fontsize='small')
    else:
        axes[i].set_title(f'Data not found for: {repo}', fontsize=14)

# Adjust layout to prevent clipping of labels and titles
plt.tight_layout()

# Save the plot as a PNG file
output_file = 'success_rate_analysis.png'
plt.savefig(output_file)

# Declare the result variable as a dictionary
result = {
    "type": "plot",
    "value": output_file
}
