        => {\n\t\tif (usesOtherValue.value) {\n\t\t\totherValue.value = newValue;\n\t\t}
        else {\n\t\t\totherValue.value = null;\n\t\t}\n\t},\n\t{ immediate: true },\n);\n\nwatch(otherValue,
        (newValue) => {\n\tif (newValue !== null && newValue !== currentValue.value)
        {\n\t\temit(newValue);\n\t}\n});\n\nreturn { otherValue, usesOtherValue };"'
