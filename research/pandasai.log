        nested $NOW'', () => {\nconst filter = {\n\t_or: [\n\t\t{\n_and: [\n\t{ status:
        { _eq: ''archived'' } },\n\t{\n\t\tmetadata: {\n\t\t\tupdated_at: { _lt: ''$NOW''
