        DateArg<Date> & {},\n  earlierDate: DateArg<Date> & {},\n  options?: DifferenceInMonthsOptions
        | undefined,\n): number {\n    const [dateLeft, dateRight] = normalizeDates(\n        options?.in,\n        laterDate,\n        earlierDate,\n      );\n\n      const
        sign = compareAsc(dateLeft, dateRight);\n      const difference = Math.abs(differenceInCalendarMonths(dateLeft,
