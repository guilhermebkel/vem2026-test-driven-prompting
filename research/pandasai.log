      - '"const { start, end } = normalizeInterval(options?.in, interval);\n  const
        step = options?.step ?? 1;\n\n  if (step === 0) return [] as any;\n\n  const
        dates: Date[] = [];\n  const reversed = step < 0 || start > end;\n  const
        absoluteStep = Math.abs(step);\n\n  const [actualStart, actualEnd] = reversed\n    ?
        [end, start]\n    : [start, end];\n\n  let currentDate = constructFrom(options?.in
        || actualStart, actualStart);\n  currentDate.setSeconds(0, 0);\n\n  while
        (currentDate.getTime() <= actualEnd.getTime()) {\n    dates.push(constructFrom(options?.in
        || currentDate, currentDate));\n    currentDate = addMinutes(currentDate,
        absoluteStep);\n  }\n\n  return (reversed ? dates.reverse() : dates) as EachMinuteOfIntervalResult<\n    IntervalType,\n    Options\n  >;"'
