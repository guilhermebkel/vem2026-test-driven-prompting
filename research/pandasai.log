        otherValue = computed<string | null>({\n\tget() {\n\t\tif (localOtherValue.value
        !== null) {\n\t\t\treturn localOtherValue.value;\n\t\t}\n\t\treturn usesOtherValue.value
        ? currentValue.value : '''';\n\t},\n\tset(newValue) {\n\t\tlocalOtherValue.value
        = newValue;\n\t\temit(newValue);\n\t},\n});\n\nwatch(currentValue, (newValue)
        => {\n\tif (newValue === null || usesOtherValue.value === false) {\n\t\tlocalOtherValue.value
        = null;\n\t}\n});\n\nreturn { otherValue, usesOtherValue };"'
