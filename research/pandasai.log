            import pandas as pd

# Load the dataframe
df = dfs[0]

# Filtrar pelos repositórios de interesse
target_repos = ['date-fns', 'directus']
filtered_df = df[df['repositoryName'].isin(target_repos)]

# Calcular a média do testCasePassRate por modelo e repositório
# O testCasePassRate é uma métrica contínua que representa o quão bem o modelo performou nos testes.
model_performance = filtered_df.groupby(['model', 'repositoryName'])['testCasePassRate'].mean().unstack()

# Remover modelos que não possuem dados em ambos os repositórios (para garantir comparação)
model_performance = model_performance.dropna()

# Calcular a diferença absoluta entre as médias dos dois repositórios
# Quanto menor a diferença, mais "consistente" o modelo é entre diferentes bases de código.
model_performance['diff'] = (model_performance['date-fns'] - model_performance['directus']).abs()

# Encontrar o modelo com a menor diferença
most_consistent_model = model_performance['diff'].idxmin()
min_diff = model_performance['diff'].min()

# Preparar o resultado
result_text = (
    f"O modelo mais consistente entre os repositórios date-fns e directus foi o '{most_consistent_model}', "
    f"com uma diferença de apenas {min_diff:.4f} na média do testCasePassRate entre os dois projetos. "
    f"Em date-fns a média foi {model_performance.loc[most_consistent_model, 'date-fns']:.4f} "
    f"e em directus foi {model_performance.loc[most_consistent_model, 'directus']:.4f}."
)

# Declare result var
result = {
    "type": "string",
    "value": result_text
}
