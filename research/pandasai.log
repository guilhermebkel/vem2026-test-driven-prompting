sns.barplot(data=df, x='experimentTitle', y='testCasePassRate', hue='model', palette='viridis')
plt.title('Pass Rate by Context Type and Model')
plt.xticks(rotation=45)
plt.ylabel('Mean Test Case Pass Rate')

# Plot 2: Impact of Relevant Test Case Count
plt.subplot(1, 2, 2)
sns.lineplot(data=df, x='relevantTestCaseCount', y='testCasePassRate', marker='o')
plt.title('Impact of Number of Relevant Test Cases')
plt.xlabel('Number of Relevant Test Cases Provided')
plt.ylabel('Mean Test Case Pass Rate')

plt.tight_layout()
plot_filename = "context_impact_analysis.png"
plt.savefig(plot_filename)

# Calculate some specific insights to answer the query
