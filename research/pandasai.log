        {\n\t\t\t\ttype: Object as PropType<Query>,\n\t\t\t\tdefault: () => ({}),\n\t\t\t},\n\t\t\tlayoutProps:
        {\n\t\t\t\ttype: Object as PropType<any>,\n\t\t\t\tdefault: () => ({}),\n\t\t\t},\n\t\t\tfilter:
        {\n\t\t\t\ttype: Object as PropType<Filter>,\n\t\t\t\tdefault: null,\n\t\t\t},\n\t\t\tfilterUser:
        {\n\t\t\t\ttype: Object as PropType<Filter>,\n\t\t\t\tdefault: null,\n\t\t\t},\n\t\t\tfilterSystem:
        {\n\t\t\t\ttype: Object as PropType<Filter>,\n\t\t\t\tdefault: null,\n\t\t\t},\n\t\t\tsearch:
        {\n\t\t\t\ttype: String as PropType<string | null>,\n\t\t\t\tdefault: null,\n\t\t\t},\n\t\t\tshowSelect:
        {\n\t\t\t\ttype: String as PropType<ShowSelect>,\n\t\t\t\tdefault: ''multiple'',\n\t\t\t},\n\t\t\tselectMode:
        {\n\t\t\t\ttype: Boolean,\n\t\t\t\tdefault: false,\n\t\t\t},\n\t\t\treadonly:
        {\n\t\t\t\ttype: Boolean,\n\t\t\t\tdefault: false,\n\t\t\t},\n\t\t\tresetPreset:
        {\n\t\t\t\ttype: Function as PropType<() => Promise<void>>,\n\t\t\t\tdefault:
        null,\n\t\t\t},\n\t\t\tclearFilters: {\n\t\t\t\ttype: Function as PropType<()
        => void>,\n\t\t\t\tdefault: null,\n\t\t\t},\n\t\t},\n\t\temits: WRITABLE_PROPS.map((prop)
        => `update:${prop}` as const),\n\t\tsetup(props, { emit }) {\n\t\t\tconst
        state: Record<string, unknown> = reactive({ ...layout.setup(props, { emit
        }), ...toRefs(props) });\n\n\t\t\tfor (const key in state) {\n\t\t\t\tstate[`onUpdate:${key}`]
        = (value: unknown) => {\n\t\t\t\t\tif (isWritableProp(key)) {\n\t\t\t\t\t\temit(`update:${key}`,
        value);\n\t\t\t\t\t} else if (!Object.keys(props).includes(key)) {\n\t\t\t\t\t\tstate[key]
