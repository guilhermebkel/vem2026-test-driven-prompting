# 4. Visualization
plt.figure(figsize=(12, 6))

# Plot 1: Bar chart of Context Type vs Pass Rate
plt.subplot(1, 2, 1)
sns.barplot(data=df, x='contextType', y='testCasePassRate', palette='viridis', errorbar=None)
plt.title('Impacto do Tipo de Contexto no Pass Rate')
plt.xticks(rotation=45)
plt.ylabel('Média de Test Case Pass Rate')

# Plot 2: Scatter plot with trend line for Test Count vs Pass Rate
plt.subplot(1, 2, 2)
sns.regplot(data=df, x='relevantTestCaseCount', y='testCasePassRate', scatter_kws={'alpha':0.5}, line_kws={'color':'red'})
plt.title('Qtd de Testes no Contexto vs Performance')
plt.xlabel('Número de Testes Relevantes')
plt.ylabel('Pass Rate')

plt.tight_layout()
chart_path = "context_pattern_analysis.png"
plt.savefig(chart_path)

# Prepare a summary description based on the numbers
