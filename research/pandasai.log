# Repository complexity
hardest_repo = repo_performance.idxmin()
summary.append(f"- Variabilidade por Repositório: O repositório '{hardest_repo}' apresentou o maior desafio para os modelos, com a menor taxa de sucesso total ({repo_performance.min():.2%}).")

# Pass rate distribution
overall_avg = df['testCasePassRate'].mean()
summary.append(f"- Média Geral: A taxa média de aprovação em casos de teste em todos os experimentos foi de {overall_avg:.2%}.")

result_text = "\n".join(summary)

# Declare result var: 
result = { "type": "string", "value": result_text }
