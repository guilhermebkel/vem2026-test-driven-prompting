        diff = Math.abs(\n    differenceInCalendarDays(laterDateNormalized, earlierDateNormalized),\n  );\n\n  const
        sign = compareLocalAsc(laterDateNormalized, earlierDateNormalized);\n\n  const
        isLastDayNotFull =\n    compareLocalAsc(\n      new Date(\n        laterDateNormalized.getFullYear(),\n        laterDateNormalized.getMonth(),\n        laterDateNormalized.getDate()
        - sign * diff,\n        laterDateNormalized.getHours(),\n        laterDateNormalized.getMinutes(),\n        laterDateNormalized.getSeconds(),\n        laterDateNormalized.getMilliseconds(),\n      ),\n      earlierDateNormalized,\n    )
        === -sign;\n\n  const result = sign * (diff - (isLastDayNotFull ? 1 : 0));\n  return
        result === 0 ? 0 : result;"'
