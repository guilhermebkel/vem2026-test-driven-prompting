            import pandas as pd
import matplotlib.pyplot as plt

# Load the dataframe
df = dfs[0]

# Filter specifically for the "permuted" context type, which represents 
# the same set of tests provided in different orders.
df_permuted = df[df['contextType'] == 'permuted-relevant-test-case'].copy()

# We want to see how much the 'passRate' varies for the same method 
# across different permutations (orders).
# We calculate the Standard Deviation of the passRate for each method.
variability_per_method = df_permuted.groupby(['repositoryName', 'methodName'])['passRate'].std().reset_index()

# Now we average that variability per repository to see which repo is overall more sensitive.
repo_sensitivity = variability_per_method.groupby('repositoryName')['passRate'].mean().sort_values(ascending=False)

# Prepare result strings and values
date_fns_sensitivity = repo_sensitivity.get('date-fns', 0)
directus_sensitivity = repo_sensitivity.get('directus', 0)

more_affected = repo_sensitivity.index[0] if not repo_sensitivity.empty else "N/A"

# Plotting the result for visualization
plt.figure(figsize=(10, 6))
repo_sensitivity.plot(kind='bar', color=['skyblue', 'salmon'])
plt.title('Sensibilidade à Ordem dos Testes (Desvio Padrão Médio do Pass Rate)')
plt.ylabel('Desvio Padrão Médio do Pass Rate')
plt.xlabel('Repositório')
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig('order_sensitivity.png')

result_text = (
    f"A ordem dos testes no prompt afeta mais o repositório **{more_affected}**. "
    f"A sensibilidade (medida pelo desvio padrão médio do pass rate entre diferentes ordens) é de "
    f"{date_fns_sensitivity:.4f} para date-fns e {direct_sensitivity:.4f} para directus."
    if not repo_sensitivity.empty else "Não foram encontrados dados de permutação suficientes para comparar."
)

# Declare result var:
result = {
    "type": "plot",
    "value": "order_sensitivity.png"
}

# Also providing a textual summary of the finding
print(result_text)
