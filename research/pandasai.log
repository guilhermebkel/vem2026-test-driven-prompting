            import pandas as pd
import matplotlib.pyplot as plt

# Get the dataframe
df = dfs[0]

# Group by modelName and calculate performance metrics
model_performance = df.groupby('modelName').agg(
    total_experiments=('modelName', 'size'),
    successful_test_suites=('isTestSuiteSuccessful', lambda x: (x == True).sum()),
    average_pass_rate=('passRate', 'mean')
)

# Calculate the success rate
model_performance['success_rate'] = model_performance['successful_test_suites'] / model_performance['total_experiments']

# Sort to find the best performing model
# Prioritize success rate, then average pass rate
best_model_performance = model_performance.sort_values(
    by=['success_rate', 'average_pass_rate'],
    ascending=[False, False]
)

# Get the name of the best performing model
best_model_name = best_model_performance.index[0]
best_model_metrics = best_model_performance.iloc[0]

# Prepare the result string
result_string = (
    f"O modelo que se saiu melhor é o **{best_model_name}**.\n\n"
    "Métricas de desempenho:\n"
    f"- Taxa de Sucesso (test suite): {best_model_metrics['success_rate']:.2%}\n"
    f"- Média da Taxa de Aprovação (passRate): {best_model_metrics['average_pass_rate']:.2f}\n"
    f"- Total de Experimentos: {best_model_metrics['total_experiments']}\n"
    f"- Test Suites Bem-sucedidas: {best_model_metrics['successful_test_suites']}\n\n"
    "Desempenho de todos os modelos:\n"
)

# Add all models performance to the result string for context
result_string += best_model_performance[['success_rate', 'average_pass_rate', 'total_experiments']].to_string(float_format=lambda x: f"{x:.2f}" if isinstance(x, (int, float)) and x >= 0 and x <= 1 else f"{x:.2f}")


# Declare result var
result = { "type": "string", "value": result_string }
