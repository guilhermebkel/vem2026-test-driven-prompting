      - '"const env = useEnv();\n\tconst logger = useLogger();\n\n\tconst allowList
        = toArray(env[`AUTH_${provider.toUpperCase()}_REDIRECT_ALLOW_LIST`]);\n\tconst
        publicUrl = env.PUBLIC_URL;\n\n\tif (publicUrl) {\n\t\tallowList.push(publicUrl);\n\t}\n\n\tif
        (allowList.length === 0) {\n\t\tlogger.warn(\n\t\t\t`No redirect allow list
        configured for provider \"${provider}\". All redirects will be blocked.`,\n\t\t);\n\t\treturn
        false;\n\t}\n\n\treturn isUrlAllowed(redirect, allowList);"'
      - '"for (const field in filter) {\n\tconst value = filter[field];\n\n\tif (typeof
        value === ''object'' && value !== null) {\n\t\tif (filterHasNow(value as Filter))
        {\n\t\t\treturn true;\n\t\t}\n\t} else if (typeof value === ''string'' &&
        value.startsWith(''$NOW'')) {\n\t\treturn true;\n\t}\n}\n\nreturn false;"'
      - '"const [laterDate_, earlierDate_] = normalizeDates(laterDate, earlierDate,
        options);\n\nconst sign = compareAsc(laterDate_, earlierDate_);\nconst difference
        = Math.abs(\n  differenceInCalendarMonths(laterDate_, earlierDate_, options),\n);\n\nif
        (difference < 1) {\n  return 0;\n}\n\nif (\n  laterDate_.getDate() < earlierDate_.getDate()
        &&\n  !isLastDayOfMonth(laterDate_, options)\n) {\n  laterDate_.setMonth(laterDate_.getMonth()
        - sign * difference);\n} else {\n  laterDate_.setMonth(laterDate_.getMonth()
        - sign * difference);\n\n  if (\n    sign > 0\n      ? compareAsc(laterDate_,
        earlierDate_) === -1\n      : compareAsc(laterDate_, earlierDate_) === 1\n  )
        {\n    return sign * (difference - 1);\n  }\n}\n\nconst result = sign * difference;\nreturn
        result === 0 ? 0 : result;"'
