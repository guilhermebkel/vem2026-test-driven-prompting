import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataframe
df = dfs[0]

# 1. Agrupar por tipo de contexto para ver a performance média
context_impact = df.groupby('contextType')[['passRate', 'testCasePassRate', 'isTestSuiteSuccessful', 'isModelResultCompilable']].mean()

# 2. Analisar a influência do tamanho do subconjunto (subsetSize) na taxa de sucesso
# Vamos calcular a correlação para ver se "mais contexto" significa "melhor resultado"
correlation_size_passrate = df[['subsetSize', 'passRate']].corr().iloc[0, 1]

# 3. Comparação Full Context vs Partial Context
full_context_comparison = df.groupby('isFullContext')[['passRate', 'testCasePassRate']].mean()

# 4. Criação de Visualização: Pass Rate por Tipo de Contexto e Modelo
plt.figure(figsize=(12, 6))
sns.set_style("whitegrid")
plot = sns.barplot(data=df, x='contextType', y='passRate', hue='model', errorbar=None)
plt.title('Impacto do Tipo de Contexto na Taxa de Passagem (Pass Rate) por Modelo')
plt.ylabel('Média de Pass Rate')
plt.xlabel('Tipo de Contexto')
plt.legend(title='Modelo', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()
plt.savefig('context_pattern_analysis.png')

# 5. Identificar se existe o efeito de "distração" (quando o contexto de teste reduz o pass rate)
# Para isso, comparamos a média de 'all-relevant-test-case' vs 'no-relevant-test-case'
summary_stats = context_impact.to_dict()

all_vs_no = ""
if 'all-relevant-test-case' in context_impact.index and 'no-relevant-test-case' in context_impact.index:
    diff = context_impact.loc['all-relevant-test-case', 'passRate'] - context_impact.loc['no-relevant-test-case', 'passRate']
    if diff > 0:
        all_vs_no = f"O contexto de testes ajuda: o 'all-relevant-test-case' teve um passRate {diff:.2f} maior que 'no-relevant-test-case'."
    else:
        all_vs_no = f"O contexto de testes não ajudou ou foi neutro: diferença de {diff:.2f} no passRate."

# Texto de conclusão
conclusao = f"""
Análise de Padrões de Contexto:
1. Impacto por Tipo: 
   - Média Pass Rate (Sem Contexto): {context_impact.loc['no-relevant-test-case', 'passRate']:.3f}
   - Média Pass Rate (Com Contexto Relevante): {context_impact.loc['all-relevant-test-case', 'passRate']:.3f}
   - Média Pass Rate (Permutado): {context_impact.loc['permuted-relevant-test-case', 'passRate']:.3f}

2. Tamanho do Contexto:
   - A correlação entre o tamanho do subconjunto de contexto e o Pass Rate é de {correlation_size_passrate:.3f}. 
   - Valores próximos de 1 indicam que quanto mais contexto, melhor o resultado. Valores próximos de 0 indicam que o volume de contexto é irrelevante.

3. Observação:
   - {all_vs_no}
   - O gráfico 'context_pattern_analysis.png' mostra como diferentes modelos reagem à adição de testes.
"""

# Declare result var: 
result = {
    "type": "plot",
    "value": "context_pattern_analysis.png"
}

# Também exibindo a conclusão textual para maior clareza
print(conclusao)
