no_relevant = pass_rate_by_context[pass_rate_by_context['contextType'] == 'no-relevant-test-case']['passRate'].values

result_text = ""
if len(all_relevant) > 0 and len(no_relevant) > 0:
    diff = all_relevant[0] - no_relevant[0]
    improvement = (diff / no_relevant[0]) * 100 if no_relevant[0] != 0 else 0
    result_text = (f"A média do passRate para 'all-relevant-test-case' é {all_relevant[0]:.2%}, "
                   f"enquanto para 'no-relevant-test-case' é {no_relevant[0]:.2%}. "
                   f"Isso representa um aumento absoluto de {diff:.2%}, ou uma melhoria de {improvement:.1f}%.")
else:
