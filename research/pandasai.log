all_context_rate = df[df['experimentTitle'] == 'all-relevant-test-case']['testCasePassRate'].mean()
permuted_rate = df[df['experimentTitle'] == 'permuted-relevant-test-case']['testCasePassRate'].mean()

comparison_text = (
