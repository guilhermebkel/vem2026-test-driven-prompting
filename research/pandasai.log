            import pandas as pd
import matplotlib.pyplot as plt

# Load the dataframe
df = dfs[0]

# Filter and clean relevant columns
# We are interested in contextType and passRate
relevant_data = df[['contextType', 'passRate']].dropna()

# Group by contextType and calculate the mean passRate
pass_rate_by_context = relevant_data.groupby('contextType')['passRate'].mean().sort_values()

# Visualization
plt.figure(figsize=(10, 6))
bars = plt.bar(pass_rate_by_context.index, pass_rate_by_context.values, color=['skyblue', 'orange', 'lightgreen'])
plt.xlabel('Context Type (Relevant Test Cases Provided)')
plt.ylabel('Mean Pass Rate')
plt.title('Comparison of Mean Pass Rate by Context Type')
plt.ylim(0, 1.1)  # Pass rate is usually between 0 and 1

# Add labels on top of bars
for bar in bars:
    yval = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, yval + 0.02, round(yval, 3), ha='center', va='bottom')

plt.tight_layout()
chart_path = "pass_rate_comparison.png"
plt.savefig(chart_path)
plt.close()

# Prepare summary statistics
no_test_rate = pass_rate_by_context.get('no-relevant-test-case', 0)
all_test_rate = pass_rate_by_context.get('all-relevant-test-case', 0)
diff = all_test_rate - no_test_rate
percent_increase = (diff / no_test_rate * 100) if no_test_rate > 0 else float('inf')

summary_text = (
    f"Sim, fornecer testes relevantes aumenta o passRate. "
    f"O passRate médio sem testes relevantes é {no_test_rate:.3f}, "
    f"enquanto com todos os testes relevantes o passRate médio sobe para {all_test_rate:.3f}, "
    f"representando um aumento de aproximadamente {percent_increase:.1f}%."
)

# Declare result var
result = {
    "type": "plot",
    "value": chart_path
}

# Also printing the summary to assist clarity
print(summary_text)
