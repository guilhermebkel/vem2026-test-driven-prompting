    success_full = full_context_performance.get(True, 0)
    success_partial = full_context_performance.get(False, 0)
    summary.append(f"- Contexto Completo vs Parcial: O uso de contexto completo (isFullContext=True) resultou em uma taxa de sucesso da suíte de testes de {success_full:.2%}, comparado a {success_partial:.2%}, para contextos parciais.")

# Model Comparison
