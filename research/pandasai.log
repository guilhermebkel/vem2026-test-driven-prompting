        || []) as string[]).filter(\n\t\t\t(val) => val !== previousValue?.value,\n\t\t);\n\n\t\tif
        (newValue === null) {\n\t\t\totherValues.value = otherValues.value.filter((o)
        => o.key !== key);\n\n\t\t\tif (valueWithoutPrevious.length === 0) {\n\t\t\t\temit(null);\n\t\t\t}
        else {\n\t\t\t\temit(valueWithoutPrevious);\n\t\t\t}\n\t\t} else {\n\t\t\totherValues.value
        = otherValues.value.map((otherValue) => {\n\t\t\t\tif (otherValue.key ===
        key) otherValue.value = newValue;\n\t\t\t\treturn otherValue;\n\t\t\t});\n\n\t\t\tif
        (valueWithoutPrevious.length === currentValues.value?.length) {\n\t\t\t\temit(valueWithoutPrevious);\n\t\t\t}
        else {\n\t\t\t\temit([...valueWithoutPrevious, newValue]);\n\t\t\t}\n\t\t}\n\t}\n}\n"'
