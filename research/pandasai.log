      - '"const [normLaterDate, normEarlierDate] = normalizeDates(\n    laterDate,\n    earlierDate,\n    options,\n  );\n\n  const
        sign = compareAsc(normLaterDate, normEarlierDate);\n  const difference = Math.abs(\n    differenceInCalendarMonths(normLaterDate,
        normEarlierDate, options),\n  );\n  let result: number;\n\n  // TODO: What
        is `isLastDayOfMonth` used for? The tests do not provide enough information
        to infer its usage.\n  // if (isLastDayOfMonth(normLaterDate, options) &&
        isLastDayOfMonth(normEarlierDate, options)) {\n  //   result = sign * difference;\n  //
        } else {\n  //   result = sign * (difference - (compareAsc(normLaterDate,
        addMonths(normEarlierDate, sign * difference, options)) > 0 ? 0 : 1));\n  //
        }\n\n  // Based on the provided test cases, the logic seems to be:\n  // If
        the later date is before the equivalent month in the earlier date,\n  // or
        if the difference is less than a full month, the result is adjusted.\n  //
        The `isLastDayOfMonth` logic is not inferable from the tests.\n\n  // Reconstructing
        based on the test cases:\n  // - \"normalizes the dates\" -> handled by `normalizeDates`\n  //
        - \"the difference is less than a month, but the given dates are in different
        calendar months\" -> implies a check for full months\n  // - \"it returns
        diff of 1 month between Feb 28 2021 and Jan 30 2021\" -> implies a specific
        calculation for partial months\n\n  // The core logic for `differenceInMonths`
        typically involves checking if the day of the month\n  // of the later date
        is \"past\" the day of the month of the earlier date in the target month.\n\n  const
        earlierDateDay = normEarlierDate.getDate();\n  const laterDateDay = normLaterDate.getDate();\n\n  if
        (sign === 1) {\n    // laterDate is after earlierDate\n    if (laterDateDay
        < earlierDateDay) {\n      result = difference - 1;\n    } else {\n      result
        = difference;\n    }\n  } else if (sign === -1) {\n    // laterDate is before
        earlierDate\n    if (laterDateDay > earlierDateDay) {\n      result = -(difference
        - 1);\n    } else {\n      result = -difference;\n    }\n  } else {\n    result
        = 0;\n  }\n\n  return result;"'
