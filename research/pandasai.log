# Plotting
plt.figure(figsize=(10, 6))
plt.bar(pass_rate_by_context['contextType'], pass_rate_by_context['passRate'], color=['#4CAF50' if 'relevant' in x and 'no-' not in x else '#F44336' for x in pass_rate_by_context['contextType']])
plt.title('Comparação do Pass Rate por Tipo de Contexto', fontsize=14)
plt.ylabel('Média do Pass Rate', fontsize=12)
plt.xlabel('Tipo de Contexto', fontsize=12)
plt.ylim(0, 1)
