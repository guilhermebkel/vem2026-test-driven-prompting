import seaborn as sns

# Load the data
df = dfs[0]

# 1. Analyze performance by context type (Experiment Title)
# We use 'testCasePassRate' as the continuous metric and 'isTestSuiteSuccessful' as the binary success metric
context_performance = df.groupby('experimentTitle')[['testCasePassRate', 'isTestSuiteSuccessful']].mean().reset_index()

# 2. Analyze the impact of the number of relevant test cases
# We want to see if more context items (relevant tests) lead to higher pass rates
context_count_impact = df.groupby('relevantTestCaseCount')['testCasePassRate'].mean().reset_index()

# Create visualizations
plt.figure(figsize=(14, 6))

# Plot 1: Pass Rate by Context Type
