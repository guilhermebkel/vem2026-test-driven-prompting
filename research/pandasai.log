            import pandas as pd

# Load the dataframe
df = dfs[0]

# Filter rows where the context type corresponds to permuted test cases
permuted_df = df[df['contextType'] == 'permuted-relevant-test-case'].copy()

# Group by method and repository to calculate the variation (max - min) in passRate
# We use max - min as the measure for variation across permutations
variation_stats = permuted_df.groupby(['repositoryName', 'methodName'])['passRate'].agg(
    lambda x: x.max() - x.min()
).reset_index()

variation_stats.rename(columns={'passRate': 'passRate_variation'}, inplace=True)

# Find the method with the highest variation
if not variation_stats.empty:
    max_variation_row = variation_stats.loc[variation_stats['passRate_variation'].idxmax()]
    method_name = max_variation_row['methodName']
    repo_name = max_variation_row['repositoryName']
    variation_value = max_variation_row['passRate_variation']
    
    result_text = f"O método com a maior variação de passRate entre as permutações foi '{method_name}' do repositório '{repo_name}', com uma variação de {variation_value:.4f}."
else:
    result_text = "Não foram encontrados dados de permutações suficientes para calcular a variação."

# Declare result var
result = { "type": "string", "value": result_text }
