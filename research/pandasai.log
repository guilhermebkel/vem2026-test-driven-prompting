            ```
            import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataframe
df = dfs[0]

# 1. Group by contextType and model to find the average pass rate for each combination
model_context_performance = df.groupby(['contextType', 'model'])['passRate'].mean().reset_index()

# 2. Pivot the data to have context types as rows and models as columns
pivot_perf = model_context_performance.pivot(index='contextType', columns='model', values='passRate')

# 3. Calculate divergence (Standard Deviation across models for each context type)
# This shows how much the models vary in performance for each specific context type
pivot_perf['divergence'] = pivot_perf.std(axis=1)
pivot_perf = pivot_perf.sort_values(by='divergence', ascending=False)

# 4. Create a visualization to illustrate the divergence
plt.figure(figsize=(12, 6))
sns.set_theme(style="whitegrid")

# Plotting the mean pass rates for each model per context type
model_context_performance_sorted = model_context_performance.sort_values('contextType')
sns.barplot(data=model_context_performance_sorted, x='contextType', y='passRate', hue='model')

plt.title('Performance do Modelo por Tipo de Contexto (Pass Rate Médio)')
plt.ylabel('Pass Rate Médio')
plt.xlabel('Tipo de Contexto')
plt.xticks(rotation=45)
plt.legend(title='Modelo', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.tight_layout()

# Save plot
plot_path = "model_divergence.png"
plt.savefig(plot_path)

# Determine which context type has the most divergence
most_divergent_context = pivot_perf['divergence'].idxmax()
highest_divergence_value = pivot_perf['divergence'].max()

# Formatting result
result_string = f"Os modelos divergem mais no tipo de contexto '{most_divergent_context}', com um desvio padrão de {highest_divergence_value:.4f} entre as taxas de acerto (passRate). "
result_string += "Os valores de divergência por contexto são:\n" + pivot_perf['divergence'].to_string()

# Declare result var
result = {
    "type": "plot",
    "value": plot_path
}

# Also providing a textual summary of the finding
print(result_string)
