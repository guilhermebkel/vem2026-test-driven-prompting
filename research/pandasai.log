        { emit, slots });\n\n\t\t\treturn {\n\t\t\t\tlayoutState: layoutSetupState,\n\t\t\t};\n\t\t},\n\t\trender()
        {\n\t\t\tif (this.$slots.default) {\n\t\t\t\treturn this.$slots.default({
