            import pandas as pd

# Load the dataframe
df = dfs[0]

# Filter rows where the context is permuted
permuted_df = df[df['contextType'] == 'permuted-relevant-test-case']

# Group by methodName and calculate the variation (range: max - min) of the passRate
# We could also use standard deviation, but range is a clear measure of total variation 
# across permutations.
variation_stats = permuted_df.groupby('methodName')['passRate'].agg(['min', 'max']).copy()
variation_stats['variation'] = variation_stats['max'] - variation_stats['min']

# Find the method with the highest variation
highest_variation_method = variation_stats['variation'].idxmax()
highest_variation_value = variation_stats['variation'].max()

# Format the result
result_text = f"O método com maior variação de passRate entre as permutações foi '{highest_variation_method}' com uma variação de {highest_variation_value:.4f} (Max: {variation_stats.loc[highest_variation_method, 'max']:.4f}, Min: {variation_stats.loc[highest_variation_method, 'min']:.4f})."

# Declare result var
result = {
    "type": "string",
    "value": result_text
}
