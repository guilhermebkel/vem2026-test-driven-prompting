        String as PropType<string | null>,\n    \t\t\tdefault: null,\n    \t\t},\n    \t\tselectMode:
        {\n    \t\t\ttype: Boolean,\n    \t\t\tdefault: false,\n    \t\t},\n    \t\treadonly:
        {\n    \t\t\ttype: Boolean,\n    \t\t\tdefault: false,\n    \t\t},\n    \t\tshowSelect:
        {\n    \t\t\ttype: String as PropType<ShowSelect>,\n    \t\t\tdefault: ''none'',\n    \t\t},\n    \t},\n    \temits:
        [''update:selection'', ''update:layoutOptions'', ''update:layoutQuery''],\n    \tsetup(props,
        { emit, slots }) {\n    \t\tconst state = reactive({\n    \t\t\t...toRefs(props),\n    \t\t})
        as any;\n\n    \t\tconst layoutState = layout.setup(props, { emit });\n\n    \t\tfor
