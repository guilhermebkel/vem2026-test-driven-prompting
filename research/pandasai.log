            import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataframe
df = dfs[0].copy()

# 1. Analyze Pass Rate by Context Type
# Group by context type to see the average performance
context_analysis = df.groupby('contextType').agg({
    'passRate': 'mean',
    'isTestSuiteSuccessful': 'mean',
    'subsetSize': 'mean'
}).sort_values(by='passRate', ascending=False)

# 2. Analyze the impact of context volume (subsetSize)
# We can check the correlation between the amount of test cases provided and the success rate
correlation = df[['subsetSize', 'passRate', 'isTestSuiteSuccessful']].corr()

# 3. Visualization
plt.figure(figsize=(14, 6))

# Subplot 1: Average Pass Rate by Context Type
plt.subplot(1, 2, 1)
sns.barplot(data=df, x='contextType', y='passRate', palette='viridis', errorbar=None)
plt.title('Average Pass Rate by Context Type')
plt.xticks(rotation=45, ha='right')
plt.ylim(0, 1.1)

# Subplot 2: Pass Rate vs Subset Size (Volume of Context)
plt.subplot(1, 2, 2)
# Using a regplot to see if there is a trend
sns.regplot(data=df, x='subsetSize', y='passRate', scatter_kws={'alpha':0.3}, line_kws={'color':'red'})
plt.title('Pass Rate vs. Number of Test Cases (Subset Size)')
plt.ylim(0, 1.1)

plt.tight_layout()
plt.savefig('context_impact_analysis.png')

# 4. Preparing the textual observation
summary_text = (
    f"A análise mostra que o tipo de contexto '{context_analysis.index[0]}' "
    f"apresenta a maior taxa de acerto média ({context_analysis['passRate'].iloc[0]:.2%}).\n"
    f"A correlação entre o número de casos de teste (subsetSize) e a taxa de acerto (passRate) "
    f"é de {correlation.loc['subsetSize', 'passRate']:.2f}.\n"
